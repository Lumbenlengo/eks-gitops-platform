            "json": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Effect\": \"Allow\",\n      \"Action\": \"sts:AssumeRoleWithWebIdentity\",\n      \"Principal\": {\n        \"Federated\": \"arn:aws:iam::962765734677:oidc-provider/oidc.eks.us-east-1.amazonaws.com/id/0E3DE1EE9358A89189759D9F4C041D42\"\n      },\n      \"Condition\": {\n        \"StringEquals\": {\n          \"oidc.eks.us-east-1.amazonaws.com/id/0E3DE1EE9358A89189759D9F4C041D42:aud\": \"sts.amazonaws.com\",\n          \"oidc.eks.us-east-1.amazonaws.com/id/0E3DE1EE9358A89189759D9F4C041D42:sub\": \"system:serviceaccount:kube-system:ebs-csi-controller-sa\"\n        }\n      }\n    }\n  ]\n}",
            "minified_json": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":\"sts:AssumeRoleWithWebIdentity\",\"Principal\":{\"Federated\":\"arn:aws:iam::962765734677:oidc-provider/oidc.eks.us-east-1.amazonaws.com/id/0E3DE1EE9358A89189759D9F4C041D42\"},\"Condition\":{\"StringEquals\":{\"oidc.eks.us-east-1.amazonaws.com/id/0E3DE1EE9358A89189759D9F4C041D42:aud\":\"sts.amazonaws.com\",\"oidc.eks.us-east-1.amazonaws.com/id/0E3DE1EE9358A89189759D9F4C041D42:sub\":\"system:serviceaccount:kube-system:ebs-csi-controller-sa\"}}}]}",
            "override_json": null,
            "override_policy_documents": null,
            "policy_id": null,
            "source_json": null,
            "source_policy_documents": null,
            "statement": [
              {
                "actions": [
                  "sts:AssumeRoleWithWebIdentity"
                ],
                "condition": [
                  {
                    "test": "StringEquals",
                    "values": [
                      "sts.amazonaws.com"
                    ],
                    "variable": "oidc.eks.us-east-1.amazonaws.com/id/0E3DE1EE9358A89189759D9F4C041D42:aud"
                  },
                  {
                    "test": "StringEquals",
                    "values": [
                      "system:serviceaccount:kube-system:ebs-csi-controller-sa"
                    ],
                    "variable": "oidc.eks.us-east-1.amazonaws.com/id/0E3DE1EE9358A89189759D9F4C041D42:sub"
                  }
                ],
                "effect": "Allow",
                "not_actions": [],
                "not_principals": [],
                "not_resources": [],
                "principals": [
                  {
                    "identifiers": [
                      "arn:aws:iam::962765734677:oidc-provider/oidc.eks.us-east-1.amazonaws.com/id/0E3DE1EE9358A89189759D9F4C041D42"
